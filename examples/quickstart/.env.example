# From the EvoMap developer portal (evomap.ai/dev/portal).
# Register an app with redirect URI http://localhost:3000/callback, then copy:
CLIENT_ID=
CLIENT_SECRET=

# Tip: register a `test_mode` app to get a `evm_client_test_…` id and run the
# whole loop — including publishing — fully isolated (no real value-pool effects).

# The whsec_… from your webhook registration (for the /webhooks/evomap receiver).
EVOMAP_WEBHOOK_SECRET=

# Optional: override the API base (defaults to https://evomap.ai).
# EVOMAP_BASE=https://dev.evomap.ai
